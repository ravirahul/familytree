# FamilyTree configuration. Copy to .env and fill in, or let /install/ write it for you.
# Never commit .env.

APP_ENV=production
APP_DOMAIN=familytree.example.com
APP_URL=https://familytree.example.com
# 64 hex characters; encrypts the passwords and keys families give for their own data homes.
# Leave empty and FamilyTree makes one in storage/app.key on first use.
APP_KEY=

# The app's own database: mysql (MySQL / MariaDB) or sqlite
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=familytree
DB_USER=familytree
DB_PASS=
DB_SSL=0
# for DB_DRIVER=sqlite (the desktop app, small self-hosts)
# DB_FILE=/absolute/path/storage/familytree.sqlite

# Mail (optional). Without SMTP the app falls back to PHP mail().
MAIL_FROM_NAME=FamilyTree
MAIL_FROM_EMAIL=noreply@familytree.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
